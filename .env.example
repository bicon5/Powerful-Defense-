# Скопируй этот файл в .env и заполни своими значениями.
# .env НИКОГДА не коммитится в git — он уже в .gitignore.
# В Railway эти же переменные задаются в разделе Variables проекта,
# отдельного .env файла на Railway не будет и не нужно.

# Токен бота из Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (Client ID) из Discord Developer Portal -> General Information
CLIENT_ID=

# ID сервера для быстрой регистрации slash-команд во время разработки
# (регистрация на конкретном сервере обновляется мгновенно, глобальная — до часа)
DEV_GUILD_ID=

# ID канала, куда бот пишет действия автомода/антирейда (создаётся автоматически при первом запуске,
# но можно указать вручную существующий канал)
MOD_LOG_CHANNEL_ID=

# ID канала для security-аудита (кто менял конфиг бота, кто выдавал права)
SECURITY_LOG_CHANNEL_ID=

# ID владельца бота — получает алерты о критичных событиях в личку
OWNER_ID=

# Порт для healthcheck-сервера (Railway сам подставит свой PORT, это фолбэк для локального запуска)
PORT=3000
